{
  description = "Austin's NixOS 26.05 config for jojo, an Acer laptop with an RTX 4060";

  # NOTE:
  #  We intentionally do NOT set experimental-features in nixConfig. Nix
  #  settings belong in the *system* nix.settings (see
  #  modules/base.nix); putting them here only affects evaluation of this
  #  flake and triggers a trust prompt.

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    home-manager.url = "github:nix-community/home-manager/release-26.05";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";

    # Plasma/KDE app settings as Home Manager options (home/austin/plasma.nix).
    # Pinned to a commit: plasma-manager has no stable release branch, so
    # following its latest code let `update` pull in changed options or
    # behavior. To move it, replace the commit with a newer one from
    # github.com/nix-community/plasma-manager/commits and run `rebuild`.
    plasma-manager = {
      url = "github:nix-community/plasma-manager/a19a2a029fa180911bd89c554dca1616e10f4c1d";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.home-manager.follows = "home-manager";
    };

    # Declarative Flatpak apps and remotes (modules/desktop.nix). `latest`
    # is the project's tag for its newest release.
    nix-flatpak.url = "github:gmodena/nix-flatpak/?ref=latest";

    # Prebuilt nix-index database: "command not found" suggests the package,
    # and `, <cmd>` runs it without installing (home/austin/bling.nix).
    nix-index-database = {
      url = "github:nix-community/nix-index-database";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # CachyOS's kernel (modules/kernel.nix). `release` is the branch whose
    # kernels its author's build server has already built and cached. Its
    # nixpkgs is deliberately not made to follow ours: its kernels are built
    # (and cached) against its own pinned nixos-unstable-small, and the
    # project warns that mixing them breaks its patches.
    nix-cachyos-kernel.url = "git+https://github.com/xddxdd/nix-cachyos-kernel?ref=release&shallow=1";

    # Optional: unstable channel for cherry-picking newer Mesa/gamescope etc.
    # without moving the whole system off 26.05. Expose it in a module via
    # `nixpkgs.overlays` as `pkgs.unstable.<pkg>`. Only add when a concrete
    # package forces the need.
    # nixpkgs-unstable.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs =
    {
      self,
      nixpkgs,
      home-manager,
      plasma-manager,
      nix-flatpak,
      nix-index-database,
      nix-cachyos-kernel,
      ...
    }:
    let
      system = "x86_64-linux";
      inherit (nixpkgs) lib;
      pkgs = nixpkgs.legacyPackages.${system};

      # Config version; see "Versions" in README.md for when to bump it.
      version = "0.6";

      # hardware-configuration.nix is regenerated by nixos-generate-config,
      # which would undo any formatting/lint fixes, so it is exempt.
      generated = "hosts/jojo/hardware-configuration.nix";
      formatter = pkgs.nixfmt-tree.override {
        settings.global.excludes = [ generated ];
      };

      # Everything jojo is built from; shared by nixosConfigurations.jojo
      # and the VM boot test (tests/boot.nix).
      jojoModules = [
        ./hosts/jojo/configuration.nix

        # Git commit the system was built from (with -dirty for uncommitted
        # changes); shown by `nixos-version --configuration-revision`.
        # The config version is added to the system label, so it shows in
        # the boot menu and the system's store path (and thus in the MOTD
        # and fastfetch; see home/austin/bling.nix).
        {
          system.configurationRevision = self.rev or self.dirtyRev or null;
          system.nixos.tags = [ version ];
        }

        nix-flatpak.nixosModules.nix-flatpak

        # pkgs.cachyosKernels, for modules/kernel.nix. The "pinned" overlay
        # builds them from the flake's own nixpkgs, which is what its binary
        # cache holds.
        { nixpkgs.overlays = [ nix-cachyos-kernel.overlays.pinned ]; }

        home-manager.nixosModules.home-manager
        {
          home-manager = {
            useGlobalPkgs = true;
            useUserPackages = true;
            sharedModules = [
              plasma-manager.homeModules.plasma-manager
              nix-index-database.homeModules.nix-index
            ];
            users.austin = import ./home/austin/home.nix;
            # When HM would clobber an unmanaged dotfile, move it to
            # <file>.hm-bak instead of failing activation. The name is
            # fixed, so overwriteBackup replaces an older .hm-bak rather
            # than failing the second time.
            backupFileExtension = "hm-bak";
            overwriteBackup = true;
          };
        }
      ];
      # What the installer test installs (tests/install.nix): jojo, plus the
      # test's root shell, QEMU's drivers, and no boot splash (so the disk
      # password prompt reaches the serial console).
      installTestSystem = lib.nixosSystem {
        inherit system;
        modules = jojoModules ++ [
          "${nixpkgs}/nixos/modules/testing/test-instrumentation.nix"
          "${nixpkgs}/nixos/modules/profiles/qemu-guest.nix"
          {
            boot.plymouth.enable = lib.mkForce false;
            # The test instrumentation's, as in tests/boot.nix: the boot
            # messages on the serial console, for the test's log.
            boot.consoleLogLevel = lib.mkForce 7;
          }
        ];
      };

      # Every flake input, inputs' inputs included, as its path in the lock
      # file ("nix-cachyos-kernel/nixpkgs") and its store path. Inputs that
      # follow another ("home-manager/nixpkgs") are that one, so they're
      # left out.
      flakeInputs =
        let
          lock = lib.importJSON ./flake.lock;
          walk =
            prefix: node: inputs:
            lib.concatLists (
              lib.mapAttrsToList (
                name: input:
                let
                  ref = lock.nodes.${node}.inputs.${name};
                in
                lib.optionals (lib.isString ref) (
                  [
                    {
                      name = prefix + name;
                      path = input.outPath;
                    }
                  ]
                  ++ walk "${prefix}${name}/" ref (input.inputs or { })
                )
              ) inputs
            );
        in
        walk "" lock.root self.inputs;
    in
    {
      # `nix fmt` formats the whole tree.
      formatter.${system} = formatter;

      # `nix flake check` fails if any of these find a problem.
      checks.${system} = {
        format = pkgs.runCommand "check-format" { nativeBuildInputs = [ formatter ]; } ''
          cp -r ${self} src && chmod -R u+w src && cd src
          treefmt --ci --tree-root .
          touch $out
        '';
        statix = pkgs.runCommand "check-statix" { nativeBuildInputs = [ pkgs.statix ]; } ''
          cd ${self}
          statix check .
          touch $out
        '';
        deadnix = pkgs.runCommand "check-deadnix" { nativeBuildInputs = [ pkgs.deadnix ]; } ''
          cd ${self}
          deadnix --fail --exclude ${generated} -- .
          touch $out
        '';
        # The README must advertise the version the flake builds.
        version = pkgs.runCommand "check-version" { } ''
          grep -q '^\*\*Current version: ${lib.escapeRegex version}\*\*' ${self}/README.md \
            || { echo "README.md 'Current version' doesn't say ${version}" >&2; exit 1; }
          touch $out
        '';

        # Boots the system in a VM and checks that it works (tests/boot.nix).
        boot = lib.nixos.runTest {
          hostPkgs = pkgs;
          imports = [
            (import ./tests/boot.nix {
              modules = jojoModules;
              inherit version;
              # The real system's version suffix (nixpkgs' date and commit,
              # which lib.nixosSystem adds and the test framework doesn't).
              inherit (self.nixosConfigurations.jojo.config.system.nixos) versionSuffix;
            })
          ];
        };
      };

      # The installer ISO (hosts/installer/configuration.nix):
      #   nix build .#installer-iso    ->  result/iso/jojo-installer-<version>.iso
      packages.${system} = {
        installer-iso = self.nixosConfigurations.installer.config.system.build.isoImage;

        # The installer end to end in VMs (tests/install.nix), run by the
        # Installer test workflow. Not one of the checks above: it needs a
        # runner of its own (about 60 GB of disk and half an hour).
        install-test = lib.nixos.runTest {
          hostPkgs = pkgs;
          imports = [
            (import ./tests/install.nix {
              inherit (self.nixosConfigurations.installer.config.system.build) installJojo;
              snapshot = "${self}";
              installedSystem = installTestSystem.config.system.build.toplevel;
              flakeInputs = map (input: input.path) flakeInputs;
              evalOverrides = lib.concatMapStringsSep " " (
                input: "--override-input ${input.name} path:${input.path}"
              ) flakeInputs;
            })
          ];
        };
      };

      # Handy dev shell: `nix develop` gives you the lint/format tooling.
      devShells.${system}.default = pkgs.mkShell {
        packages = [
          formatter
          pkgs.statix
          pkgs.deadnix
        ];
      };

      nixosConfigurations.jojo = lib.nixosSystem {
        inherit system;
        modules = jojoModules;
      };

      # Live Plasma USB that installs the jojo config above (see
      # hosts/installer/configuration.nix). Built as packages.installer-iso.
      nixosConfigurations.installer = lib.nixosSystem {
        inherit system;
        specialArgs = { inherit self version; };
        modules = [ ./hosts/installer/configuration.nix ];
      };
    };
}
